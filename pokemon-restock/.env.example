# SQLite by default — no database server needed.
DATABASE_URL="file:./prisma/dev.db"

# Shared secret for POST /api/cron/check. Generate with: openssl rand -hex 32
CRON_SECRET="dev-cron-secret-change-me"

# Optional: where restock alerts go. Leave unset and alerts are logged only.
ALERT_WEBHOOK_URL=""

# Optional: identifies the checker to retailers. Be honest here.
CHECKER_USER_AGENT="RestockRadar/0.1 (+https://example.com/about)"
